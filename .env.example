# UI sandbox only. These values are placeholders, not production secrets.
MOCK_DATA=true
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=sandbox-nextauth-secret-change-me
JWT_SECRET=sandbox-jwt-secret-change-me

# Leave database and Supabase empty. The app reads src/lib/sample-data.ts.
DATABASE_URL=
DIRECT_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

